<h1 class="page-title">予約する</h1>

<div class="card">
  <div class="card-body">
    <div class="card-title"><%= @room.title %></div>

    <%= form_with model: [@room, @reservation],
          url: confirm_room_reservations_path(@room),
          data: { turbo: false },
          local: true,
          class: "form form--card reservation-form" do |f| %>

      <div class="form-row">
        <%= f.label :check_in_on, "チェックイン", class: "label" %>
        <%= f.date_field :check_in_on, class: "input" %>
        <%= render "shared/field_error", object: @reservation, field: :check_in_on %>
      </div>

      <div class="form-row">
        <%= f.label :check_out_on, "チェックアウト", class: "label" %>
        <%= f.date_field :check_out_on, class: "input" %>
        <%= render "shared/field_error", object: @reservation, field: :check_out_on %>
      </div>

      <div class="form-row">
        <%= f.label :guests_count, "人数", class: "label" %>
        <%= f.number_field :guests_count, min: 1, class: "input" %>
        <%= render "shared/field_error", object: @reservation, field: :guests_count %>
      </div>

      <div class="form-actions">
        <%= f.submit "確認へ進む", class: "btn btn-primary" %>
        <%= link_to "施設詳細に戻る", room_path(@room), class: "btn" %>
      </div>
    <% end %>
  </div>
</div>
