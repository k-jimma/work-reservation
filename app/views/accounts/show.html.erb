<h1 class="page-title">アカウント情報</h1>

<div class="card">
  <div class="card-body">
    <div class="stack">
      <div>
        <div class="text-muted text-small">メールアドレス</div>
        <div class="fw-bold">
          <%= current_user&.email || "（ログインしていません）" %>
        </div>
      </div>

      <% if current_user&.name.present? %>
        <div>
          <div class="text-muted text-small">パスワード</div>
          <div class="fw-bold">*********</div>
        </div>
      <% end %>
    </div>

    <% if current_user&.name.present? %>
      <div class="mt-24">
        <%= link_to "編集", edit_account_path, class: "btn btn-primary" %>
      </div>
    <% end %>

  </div>
</div>
