<h1><%= @room.title %></h1>

<%= room_image_tag(@room, width: 400) %>

<p>
  <strong>住所:</strong><br>
  <%= @room.address %>
</p>

<p>
  <strong>説明:</strong><br>
  <%= @room.description %>
</p>

<p>
  <strong>料金:</strong><br>
  <%= yen(@room.price_per_night) %> / 泊
</p>

<p>
  <%= link_to "この施設を予約する", new_room_reservation_path(@room) %>
</p>

<p>
  <%= link_to "一覧に戻る", rooms_path %>
</p>
