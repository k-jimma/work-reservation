<h1 class="page-title">
  施設を登録する
</h1>

<%= form_with model: @room, local: true, html: { multipart: true }, class: "form form--card room-form" do |f| %>

  <div class="form-row">
    <%= f.label :title, "施設名", class: "label" %>
    <%= f.text_field :title, class: "input", required: true %>
    <%= render "shared/field_error", object: @room, field: :title %>
  </div>

  <div class="form-row">
    <%= f.label :address, "住所", class: "label" %>
    <%= f.text_field :address, class: "input", required: true %>
    <%= render "shared/field_error", object: @room, field: :address %>
  </div>

  <div class="form-row">
    <%= f.label :description, "説明", class: "label" %>
    <%= f.text_area :description, class: "textarea" %>
    <%= render "shared/field_error", object: @room, field: :description %>
  </div>

  <div class="form-row">
    <%= f.label :price_per_night, "料金（1泊）", class: "label" %>
    <%= f.number_field :price_per_night, class: "input", min: 0, step: 1, required: true %>
    <%= render "shared/field_error", object: @room, field: :price_per_night %>
  </div>

  <div class="form-row">
    <%= f.label :image, "施設画像", class: "label" %>
    <%= f.file_field :image, class: "input input--file", accept: "image/*" %>
    <div class="form-help">
      画像は任意です。未選択のままでも登録できます。
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit "登録する", class: "btn btn-primary" %>
    <%= link_to "戻る", mine_rooms_path, class: "btn" %>
  </div>

<% end %>
