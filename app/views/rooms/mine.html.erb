<h1>自分の施設一覧</h1>

<p>
  <%= link_to "施設を登録する", new_room_path %>
</p>

<% if @rooms.any? %>
  <ul>
    <% @rooms.each do |room| %>
      <li style="margin-bottom: 12px;">
        <%= room_image_tag(room, width: 200) %>
        <strong>
          <%= link_to room.title, room_path(room) %>
        </strong><br>

        <span>住所: <%= room.address %></span><br>
        <span>料金: <%= yen(room.price_per_night) %> / 泊</span><br>

        <%= link_to "編集", edit_room_path(room) %> |
        <div data-controller="confirm-modal" style="display:inline;">
          <button type="button" data-action="confirm-modal#open">削除</button>

          <dialog data-confirm-modal-target="dialog" style="padding:16px; border:1px solid #ddd; border-radius:10px; max-width:520px; width:100%;">
            <h3 style="margin:0 0 12px;">この施設を削除しますか？</h3>

            <div style="display:flex; gap:12px; align-items:flex-start;">
              <div style="width:160px; flex:0 0 160px;">
                <%= room_image_tag(room, style: "width:100%; height:auto; border-radius:8px; display:block;") %>
              </div>

              <div style="flex:1;">
                <div style="font-weight:700;"><%= room.title %></div>
                <div style="color:#666; margin-top:6px;"><%= yen(room.price_per_night) %> / 泊</div>
              </div>
            </div>

            <p style="margin-top:10px; color:#b45309; font-weight:700;">
              注意：この施設に紐づく予約も一緒に削除されます。
            </p>

            <div style="display:flex; gap:10px; justify-content:flex-end; margin-top:16px;">
              <button type="button" data-action="confirm-modal#close">キャンセル</button>

              <%= button_to "削除する",
                    room_path(room),
                    method: :delete,
                    form: { data: { turbo_confirm: nil } },
                    data: { turbo: true },
                    style: "background:#d9534f; color:#fff; border:none; padding:8px 12px; border-radius:6px; cursor:pointer;" %>
            </div>
          </dialog>
        </div>

      </li>
    <% end %>
  </ul>
<% else %>
  <p>まだ施設が登録されていません。</p>
<% end %>

<p>
  <%= link_to "トップへ戻る", root_path %>
</p>
