<h1>施設を編集する</h1>

<%= form_with model: @room, local: true, html: { multipart: true } do |f| %>
  <p>
    <%= f.label :title, "施設名" %><br>
    <%= f.text_field :title %>
  </p>

  <p>
    <%= f.label :address, "住所" %><br>
    <%= f.text_field :address %>
  </p>

  <p>
    <%= f.label :description, "説明" %><br>
    <%= f.text_area :description %>
  </p>

  <p>
    <%= f.label :price_per_night, "料金（1泊）" %><br>
    <%= f.number_field :price_per_night %>
  </p>

  <p>
    <%= f.label :image, "施設画像" %><br>
    <%= f.file_field :image, accept: "image/*" %>

    <% if @room.image.attached? %>
      <p>現在の画像：</p>
      <%= image_tag @room.image, style: "width:120px; height:auto;" %>
    <% end %>
  </p>

  <p>
    <%= f.submit "更新する" %>
  </p>
<% end %>

<p>
  <%= link_to "戻る", mine_rooms_path %>
</p>
