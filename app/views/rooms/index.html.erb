<h1>施設一覧</h1>

<div style="margin: 12px 0 18px;">
  <%= form_with url: rooms_path, method: :get, local: true do |f| %>
    <div style="display:flex; gap:8px; align-items:center;">
      <%= f.search_field :q,
            value: params[:q],
            placeholder: "施設名・住所・説明文で検索（例: 駅近）",
            style: "flex:1; padding:10px 12px; border:1px solid #ddd; border-radius:8px;" %>

      <%= f.submit "検索",
            style: "padding:10px 14px; border:1px solid #111; background:#111; color:#fff; border-radius:8px; cursor:pointer;" %>

      <% if params[:q].present? %>
        <%= link_to "クリア", rooms_path,
              style: "padding:10px 12px; border:1px solid #ddd; border-radius:8px;" %>
      <% end %>
    </div>
  <% end %>

  <% if params[:q].present? %>
    <p style="margin:10px 0 0; color:#666;">
      検索: <%= params[:q] %>
    </p>
  <% end %>
</div>

<% if @rooms.any? %>
  <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap:12px;">
    <% @rooms.each do |room| %>
      <div style="border:1px solid #ddd; border-radius:10px; overflow:hidden; background:#fff;">
        <%= room_image_tag(room, style: "width:100%; height:160px; object-fit:cover; display:block;") %>

        <div style="padding:12px;">
          <div style="font-weight:700; font-size:16px; line-height:1.3;">
            <%= link_to room.title, room_path(room) %>
          </div>

          <div style="margin-top:6px; color:#666; font-size:13px; line-height:1.5;">
            <%= room.address %>
          </div>

          <div style="margin-top:10px; display:flex; justify-content:space-between; align-items:center;">
            <div style="font-weight:700;">
              <%= yen(room.price_per_night) %> <span style="font-weight:400; color:#666;">/ 泊</span>
            </div>

            <%= link_to "詳細", room_path(room),
                  style: "padding:8px 10px; border:1px solid #ddd; border-radius:8px;" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div style="border:1px dashed #ccc; border-radius:10px; padding:16px; color:#666;">
    <div style="font-weight:700; color:#111;">該当する施設が見つかりませんでした。</div>
    <div style="margin-top:6px; line-height:1.7;">
      キーワードを変えて試してみてください（例: 駅近 / 渋谷 / 駐車場 など）。
    </div>
  </div>
<% end %>
